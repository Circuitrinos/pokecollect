# Nightly student trainer (tools/nightly_student.py): the matcher's code plus
# PyTorch for the CPU. Built from the matcher folder:
#   docker build -f Dockerfile.trainer -t pokecollect-trainer .
FROM python:3.12-slim

# tzdata: TRAIN_AT is local time (TZ in the compose file)
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
# CPU-only PyTorch (the default Linux wheels bring ~3 GB of CUDA libraries)
RUN pip install --no-cache-dir -r requirements.txt \
 && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch torchvision \
 && pip install --no-cache-dir onnx==1.23.2
COPY app/ ./app/
COPY tools/ ./tools/

# Same uid as the rest of PokéCollect; /data and the matcher's folder must be writable by it.
RUN groupadd --system --gid 3010 pokecollect \
 && useradd --system --uid 3010 --gid 3010 --no-create-home pokecollect
USER 3010:3010
ENV HOME=/tmp PYTHONUNBUFFERED=1

CMD ["python", "tools/nightly_student.py"]
